{
  "name": "decky-translator",
  "version": "1.0.0",
  "type": "module",
  "description": "Translate anything on screen to your language. Works with any game or application - a great tool for language learning or enjoying untranslated games",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests/frontend",
    "test:e2e": "node --test --test-reporter=spec tests/e2e/translate.e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aqvilinus/windecky-translator.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "translation",
    "language-learning",
    "steam-deck",
    "deck"
  ],
  "author": "Aqvilinus",
  "license": "GNU GPLv3",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "bugs": {
    "url": "https://github.com/Aqvilinus/windecky-translator/issues"
  },
  "homepage": "https://github.com/Aqvilinus/windecky-translator",
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "4.16.4",
    "@types/react": "16.14.0",
    "@types/react-dom": "^19.1.2",
    "rollup": "^4.66.0",
    "shx": "0.4.0",
    "tslib": "^2.4.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "react-icons": "^4.4.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "remote_binary": []
}
